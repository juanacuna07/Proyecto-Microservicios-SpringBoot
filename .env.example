# Copie este archivo:  cp .env.example .env   y ajuste los valores.
# El archivo .env NO se sube a Git (esta en .gitignore).

# Usuario de Docker Hub donde se publican las imagenes (OBLIGATORIO para publicar)
DOCKERHUB_USER=tu_usuario_dockerhub
IMAGE_TAG=2.0.0

# Credenciales locales de PostgreSQL (en produccion: gestor de secretos)
POSTGRES_USER=postgres
AUTH_DB_PASSWORD=cambie_esta_clave_auth
USERS_DB_PASSWORD=cambie_esta_clave_users

# JWT
JWT_ISSUER=taller-02-auth-service
JWT_EXPIRATION_MINUTES=60

# Usuarios demo admin/student (solo ambiente local)
DEMO_DATA_ENABLED=true
